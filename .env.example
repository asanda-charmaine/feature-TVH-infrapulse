# SMTP settings for citizen confirmation emails.
# Leave SMTP_HOST empty to run in demo mode (emails are simulated, never blocking submission).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InfraPulse
SMTP_USE_TLS=true

# API port (the Vite dev server proxies /api to this)
API_PORT=8787
